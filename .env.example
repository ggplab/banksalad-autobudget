# banksalad-budget-organizer 설정 — 이 파일을 .env 로 복사해 채운다. (.env 는 git 에 안 올라간다)
# 전부 선택 사항이다. 아무것도 안 채우면: 파일 드롭 → 태깅 → LLM 건너뜀(openrouter 키 없음) → dist/budget.html

# ── 1. Trigger: export 를 어떻게 받나 ─────────────────────────────────
# 뱅샐 앱에서 export 할 때 정한 zip 비밀번호 (zip 을 직접 넘기거나 Gmail 수신 시 필요. xlsx 를 넘기면 불필요)
BUDGET_ZIP_PASSWORD=
# Gmail 자동 수신 — scripts/gmail_client.py --auth 로 토큰을 만들면 켜진다. 경로 바꿀 때만 지정
# BUDGET_GMAIL_CLIENT_SECRET=~/.config/banksalad-budget/client_secret.json
# BUDGET_GMAIL_TOKEN=~/.config/banksalad-budget/gmail-token.json

# ── 2. Enrich: 주문메일 품목 보강 (쿠팡·컬리·네이버페이) ──────────────
# 주문메일이 export 메일과 다른 Gmail 계정에 있으면 별도 토큰 (--auth --profile orders)
# BUDGET_ORDERS_GMAIL_TOKEN=~/.config/banksalad-budget/gmail-token-orders.json
# 보강을 끄려면 0
# BUDGET_ENRICH=0

# ── 3. LLM: 애매한 거래 용도 추론 ──────────────────────────────────────
# openrouter(기본, API 키 필요) | claude (Claude Code CLI `claude -p`) | codex (`codex exec`) | gemini (`gemini -p`) | none
BUDGET_LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
# 모델 지정 (비우면 백엔드 기본값: openrouter=anthropic/claude-sonnet-5, claude=sonnet, codex·gemini=CLI 기본)
# BUDGET_LLM_MODEL=
# 이 확신도 미만이면 반영하지 않는다 (기본 0.6)
# BUDGET_LLM_MIN_CONF=0.6

# ── 4. Target: 산출물을 어디로 ─────────────────────────────────────────
# html(기본) | email | discord | hook | artifact — 콤마로 여러 개
BUDGET_TARGETS=html
# email: Gmail 이면 앱 비밀번호 (계정 → 보안 → 2단계 인증 → 앱 비밀번호)
# BUDGET_SMTP_HOST=smtp.gmail.com
# BUDGET_SMTP_PORT=587
# BUDGET_SMTP_USER=you@gmail.com
# BUDGET_SMTP_PASSWORD=
# BUDGET_EMAIL_TO=you@gmail.com
# discord: 채널 → 연동 → 웹후크. 결과 카드(finish)도 같은 곳으로 간다
# BUDGET_DISCORD_WEBHOOK_URL=
# hook: 산출물 디렉토리를 인자로 받는 스크립트 (scp·rclone·S3 업로드 등 자기 방식)
# BUDGET_DEPLOY_HOOK=./deploy.sh

# ── 경로 (기본값으로 충분) ──────────────────────────────────────────────
# BUDGET_DATA_DIR=./data        # DB·export·백업·상태
# BUDGET_OUT_DIR=./dist         # 산출물
# BUDGET_MIN_ROWS=10            # export 행수가 이보다 적으면 빈 파일로 보고 중단
